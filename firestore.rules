rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{householdId} {
      // Get: any authenticated user can look up a specific household (needed for join flow)
      allow get: if request.auth != null;

      // List/query: only members (used by the "my households" query)
      allow list: if request.auth != null
        && request.auth.uid in resource.data.members;

      // Create: must place self in both members and admins
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.admins is list
        && request.auth.uid in request.resource.data.admins;

      // Update: role-based access
      allow update: if request.auth != null
        && (
          // Admin member: full update access
          (
            request.auth.uid in resource.data.members
            && request.auth.uid in resource.data.admins
          )
          // Regular member: can update lists OR leave (remove self)
          || (
            request.auth.uid in resource.data.members
            && request.resource.data.name == resource.data.name
            && request.resource.data.admins == resource.data.admins
            && (
              // Sub-case A: update lists only (members + memberInfo unchanged)
              (
                request.resource.data.members == resource.data.members
                && request.resource.data.memberInfo == resource.data.memberInfo
              )
              // Sub-case B: leave — remove self from members, lists unchanged
              || (
                !(request.auth.uid in request.resource.data.members)
                && request.resource.data.members.size() == resource.data.members.size() - 1
                && request.resource.data.lists == resource.data.lists
              )
            )
          )
          // Non-member: can only join (add self to members + own memberInfo)
          || (
            !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.lists == resource.data.lists
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.name == resource.data.name
          )
        );

      // Disallow delete entirely
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
